CC := gcc
SRC := ./src
CFLAGS += -I./raylib/include -L./raylib/lib -Wall -Wextra -Wno-missing-field-initializers -Wpedantic --std=c11 -ggdb
STATIC_LFLAGS += -l:libraylib.a -lm
LFLAGS += -lraylib -lm
BUILD_DIR += build

SOURCES := $(wildcard $(SRC)/*/*.c) $(wildcard $(SRC)/*.c)
OBJECTS := $(SOURCES:.c=.o)

DEPENDS := $(patsubst %.c,%.d, $(SOURCES))
CFLAGS += -MMD -MP

run: build/testRl makefile
	./build/testRl

#run: build/test makefile
#	./build/test

build/testRl: build/testRl.o build/entity.o build/uuid4.o build/entity_json.o build/cJSON.o
	$(CC) -o $@ $^ $(CFLAGS) $(STATIC_LFLAGS)

build/test: build/test.o build/entity.o build/uuid4.o build/entity_json.o build/cJSON.o
	$(CC) -o $@ $^ $(CFLAGS) $(STATIC_LFLAGS)

build/testRl.o: src/testRl.c
	$(CC) -o $@ -c $< $(CFLAGS)

build/test.o: src/test.c src/entity.o build/uuid4.o build/entity_json.o build/cJSON.o
	$(CC) -o $@ -c $< $(CFLAGS)

build/entity.o: src/entity.c
	$(CC) -o $@ -c $< $(CFLAGS)

build/entity_json.o: src/entity_json.c build/cJSON.o
	$(CC) -o $@ -c $< $(CFLAGS)

build/cJSON.o: ./third_party/cJSON/cJSON.c
	$(CC) -o $@ -c $<

build/uuid4.o: ./third_party/uuid4/src/uuid4.c
	$(CC) -o $@ -c $<

# include the makefiles generated by gcc -MMD
-include $(DEPENDS)
linter:
	bear -- make -B
